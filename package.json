{
  "name": "stylle-screen-hd",
  "productName": "StylleScreen HD",
  "version": "1.0.0",
  "description": "StylleScreen HD - capture, anote e copie a tela em segundos",
  "main": "main.js",
  "author": "StylleScreen HD",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.stylle.screenhd",
    "productName": "StylleScreen HD",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "StylleScreen HD",
      "runAfterFinish": true
    }
  }
}
